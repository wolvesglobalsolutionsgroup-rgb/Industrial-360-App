rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // HELPERS — Perfil de usuario
    // ===============================================================
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().role == 'superadmin';
    }

    function belongsToOrg(orgId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().orgId == orgId;
    }

    function hasRoleInOrg(orgId, roles) {
      return isSuperadmin() || (belongsToOrg(orgId) && userProfile().role in roles);
    }

    function isOrgDocument(orgId) {
      return request.resource.data.orgId == orgId;
    }

    function preservesOrg(orgId) {
      return request.resource.data.orgId == orgId
        && request.resource.data.orgId == resource.data.orgId;
    }

    // ===============================================================
    // USUARIOS
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId
        || userProfile().orgId == resource.data.orgId
      );
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['role']);
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && !request.resource.data.keys().hasAny(['role', 'orgId']))
        || isSuperadmin()
      );
      allow delete: if isSuperadmin();
    }

    // ===============================================================
    // COLECCIONES LEGACY — BLOQUEADAS
    // ===============================================================
    match /projects/{document} { allow read, write: if false; }
    match /tasks/{document} { allow read, write: if false; }
    match /valuations/{document} { allow read, write: if false; }
    match /expenses/{document} { allow read, write: if false; }
    match /field_reports/{document} { allow read, write: if false; }
    match /siho_ptw/{document} { allow read, write: if false; }
    match /ptws/{document} { allow read, write: if false; }
    match /weld_joints/{document} { allow read, write: if false; }
    match /welds/{document} { allow read, write: if false; }
    match /ndt_reports/{document} { allow read, write: if false; }
    match /inventory/{document} { allow read, write: if false; }
    match /documents/{document} { allow read, write: if false; }
    match /ili_runs/{document} { allow read, write: if false; }
    match /standby_claims/{document} { allow read, write: if false; }
    match /moc_requests/{document} { allow read, write: if false; }
    match /fleet_equipment/{document} { allow read, write: if false; }
    match /interop_imports/{document} { allow read, write: if false; }
    match /dossier_compilations/{document} { allow read, write: if false; }
    match /engineering_calcs/{document} { allow read, write: if false; }
    match /settings/{document} { allow read, write: if false; }

    // ===============================================================
    // CLIENT PORTALS — SOLO VÍA ANIDADA (raíz eliminada)
    // NOTA: No permitimos escritura directa desde cliente.
    //       Los portales se gestionan vía Cloud Function.
    // ===============================================================
    match /client_portals/{portalId} { allow read, write: if false; }
    match /client_portal_access_logs/{logId} { allow read, write: if false; }

    // ===============================================================
    // MULTI-TENANCY
    // ===============================================================
    match /organizations/{orgId} {
      allow read: if hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector', 'campo']);
      allow create, update, delete: if isSuperadmin();

      // CLIENT PORTALS (anidados)
      match /client_portals/{portalId} {
        allow read: if hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector', 'campo']);
        allow create: if hasRoleInOrg(orgId, ['gerente', 'supervisor'])
          && isOrgDocument(orgId);
        allow update: if hasRoleInOrg(orgId, ['gerente', 'supervisor'])
          && preservesOrg(orgId);
        allow delete: if isSuperadmin();
      }

      match /projects/{projId} {
        allow read: if hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector', 'campo']);
        allow create: if hasRoleInOrg(orgId, ['gerente', 'supervisor'])
          && isOrgDocument(orgId);
        allow update: if hasRoleInOrg(orgId, ['gerente', 'supervisor'])
          && preservesOrg(orgId);
        allow delete: if isSuperadmin();

        // TASKS
        match /tasks/{taskId} {
          allow read: if hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector', 'campo']);
          allow create: if hasRoleInOrg(orgId, ['gerente', 'supervisor'])
            && isOrgDocument(orgId);
          allow update: if hasRoleInOrg(orgId, ['gerente', 'supervisor'])
            && preservesOrg(orgId);
          allow delete: if hasRoleInOrg(orgId, ['gerente']);
        }

        // EXPENSES
        match /expenses/{expenseId} {
          allow read: if hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector', 'campo']);
          allow create: if hasRoleInOrg(orgId, ['gerente'])
            && isOrgDocument(orgId);
          allow update: if hasRoleInOrg(orgId, ['gerente'])
            && preservesOrg(orgId);
          allow delete: if isSuperadmin();
        }

        // VALUATIONS
        match /valuations/{valuationId} {
          allow read: if hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector', 'campo']);
          allow create: if hasRoleInOrg(orgId, ['gerente', 'supervisor'])
            && isOrgDocument(orgId);
          allow update: if hasRoleInOrg(orgId, ['gerente', 'supervisor'])
            && preservesOrg(orgId);
          allow delete: if isSuperadmin();
        }

        // SIHO PTW
        match /siho_ptw/{ptwId} {
          allow read: if hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector', 'campo']);
          allow create: if hasRoleInOrg(orgId, ['campo', 'inspector'])
            && isOrgDocument(orgId);
          allow update: if hasRoleInOrg(orgId, ['campo', 'inspector'])
            && preservesOrg(orgId);
          allow delete: if hasRoleInOrg(orgId, ['gerente']);
        }

        // QA/QC WELD JOINTS
        match /weld_joints/{jointId} {
          allow read: if hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector']);
          allow create: if hasRoleInOrg(orgId, ['inspector'])
            && isOrgDocument(orgId);
          allow update: if hasRoleInOrg(orgId, ['inspector'])
            && preservesOrg(orgId);
          allow delete: if hasRoleInOrg(orgId, ['gerente']);
        }

        // FIELD REPORTS
        match /field_reports/{reportId} {
          allow read: if hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector', 'campo']);
          allow create: if hasRoleInOrg(orgId, ['campo'])
            && isOrgDocument(orgId);
          allow update: if hasRoleInOrg(orgId, ['campo'])
            && preservesOrg(orgId);
          allow delete: if hasRoleInOrg(orgId, ['gerente']);
        }

        // INVENTORY
        match /inventory/{itemId} {
          allow read: if hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector', 'campo']);
          allow create: if hasRoleInOrg(orgId, ['supervisor', 'gerente'])
            && isOrgDocument(orgId);
          allow update: if hasRoleInOrg(orgId, ['supervisor', 'gerente'])
            && preservesOrg(orgId);
          allow delete: if hasRoleInOrg(orgId, ['gerente']);
        }

        // DOCUMENTS
        match /documents/{documentId} {
          allow read: if hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector', 'campo']);
          allow create: if hasRoleInOrg(orgId, ['supervisor', 'gerente'])
            && isOrgDocument(orgId);
          allow update: if hasRoleInOrg(orgId, ['supervisor', 'gerente'])
            && preservesOrg(orgId);
          allow delete: if hasRoleInOrg(orgId, ['gerente']);
        }

        // ILI RUNS
        match /ili_runs/{runId} {
          allow read: if hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector']);
          allow create: if hasRoleInOrg(orgId, ['inspector'])
            && isOrgDocument(orgId);
          allow update: if hasRoleInOrg(orgId, ['inspector'])
            && preservesOrg(orgId);
          allow delete: if hasRoleInOrg(orgId, ['gerente']);
        }

        // DOSSIER COMPILATIONS
        match /dossier_compilations/{compilationId} {
          allow read: if hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector', 'campo']);
          allow create: if hasRoleInOrg(orgId, ['supervisor', 'gerente'])
            && isOrgDocument(orgId);
          allow update: if hasRoleInOrg(orgId, ['supervisor', 'gerente'])
            && preservesOrg(orgId);
          allow delete: if hasRoleInOrg(orgId, ['gerente']);
        }
      }
    }
  }
}
