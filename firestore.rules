rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : 'none';
    }

    function isSuperadmin() {
      return isAuthenticated() && (
        getUserRole() == 'superadmin' ||
        (request.auth.token.email == "wolvesglobalsolutionsgroup@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isGerente() {
      return isAuthenticated() && (getUserRole() in ['superadmin', 'gerente']);
    }

    function isSupervisor() {
      return isAuthenticated() && (getUserRole() in ['superadmin', 'gerente', 'supervisor']);
    }

    function isInspector() {
      return isAuthenticated() && (getUserRole() in ['superadmin', 'gerente', 'supervisor', 'inspector']);
    }

    function isCampo() {
      return isAuthenticated() && (getUserRole() in ['superadmin', 'gerente', 'supervisor', 'inspector', 'campo']);
    }

    function isCliente() {
      return isAuthenticated();
    }

    // ===============================================================
    // Multi-Tenancy Hierarchy: /organizations/{orgId}
    // ===============================================================
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if isSuperadmin();

      match /projects/{projId} {
        allow read: if isAuthenticated();
        allow create, update: if isGerente();
        allow delete: if isSuperadmin();

        // Subcolecciones de Proyecto
        match /tasks/{taskId} {
          allow read: if isAuthenticated();
          allow write: if isSupervisor();
        }

        match /field_reports/{reportId} {
          allow read: if isAuthenticated();
          allow write: if isCampo();
        }

        match /valuations/{valuationId} {
          allow read: if isAuthenticated();
          allow write: if isGerente();
        }

        match /documents/{documentId} {
          allow read: if isAuthenticated();
          allow write: if isSupervisor();
        }

        match /expenses/{expenseId} {
          allow read: if isAuthenticated();
          allow write: if isGerente();
        }

        match /inventory/{itemId} {
          allow read: if isAuthenticated();
          allow write: if isSupervisor();
        }

        match /siho_ptw/{ptwId} {
          allow read: if isAuthenticated();
          allow write: if isCampo();
        }

        match /weld_joints/{jointId} {
          allow read: if isAuthenticated();
          allow write: if isInspector();
        }

        match /ndt_reports/{reportId} {
          allow read: if isAuthenticated();
          allow write: if isInspector();
        }

        match /ili_runs/{runId} {
          allow read: if isAuthenticated();
          allow write: if isInspector();
        }

        match /standby_claims/{claimId} {
          allow read: if isAuthenticated();
          allow write: if isGerente();
        }

        match /moc_requests/{mocId} {
          allow read: if isAuthenticated();
          allow write: if isGerente();
        }

        match /fleet_equipment/{equipId} {
          allow read: if isAuthenticated();
          allow write: if isSupervisor();
        }

        match /dossier_compilations/{dossierId} {
          allow read: if isAuthenticated();
          allow write: if isGerente();
        }

      }

      // Subcolecciones directas de Organización
      match /client_portals/{portalId} {
        // La exposición pública se debe realizar mediante una función que entregue
        // una vista limitada y un enlace con token temporal; nunca el documento base.
        allow read: if isAuthenticated();
        allow write: if isGerente();
      }

      match /engineering_calcs/{calcId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ===============================================================
    // Legacy Collections (Compatibilidad Directa)
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Cada usuario solo puede crear o editar su propio perfil. Los roles se
      // administran desde un entorno de confianza (Admin SDK), no desde el cliente.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && !('role' in request.resource.data);
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isSuperadmin();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /field_reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isCampo();
    }

    match /valuations/{valuationId} {
      allow read: if isAuthenticated();
      allow write: if isGerente();
    }

    match /documents/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow write: if isGerente();
    }

    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /routes/{routeId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /siho_ptw/{ptwId} {
      allow read: if isAuthenticated();
      allow write: if isCampo();
    }

    match /weld_joints/{jointId} {
      allow read: if isAuthenticated();
      allow write: if isInspector();
    }

    match /ndt_reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isInspector();
    }

    match /ili_runs/{runId} {
      allow read: if isAuthenticated();
      allow write: if isInspector();
    }

    match /standby_claims/{claimId} {
      allow read: if isAuthenticated();
      allow write: if isGerente();
    }

    match /moc_requests/{mocId} {
      allow read: if isAuthenticated();
      allow write: if isGerente();
    }

    match /fleet_equipment/{equipId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /interop_imports/{importId} {
      allow read: if isGerente();
      allow write: if isSupervisor();
    }

    match /dossier_compilations/{dossierId} {
      allow read: if isAuthenticated();
      allow write: if isGerente();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isGerente();
    }

    match /client_portals/{portalId} {
      allow read: if isAuthenticated();
      allow write: if isGerente();
    }

    match /engineering_calcs/{calcId} {
      allow read, write: if isAuthenticated();
    }
  }
}
