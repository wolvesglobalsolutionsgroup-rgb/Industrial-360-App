rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions & Role Enforcement
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : null;
    }

    function isSuperadmin() {
      return isAuthenticated() && getUserRole() == 'superadmin';
    }

    function belongsToOrg(orgId) {
      return isAuthenticated() && getUserData().orgId == orgId;
    }

    function isGerenteInOrg(orgId) {
      return belongsToOrg(orgId) && getUserRole() in ['superadmin', 'gerente'];
    }

    function isSupervisorInOrg(orgId) {
      return belongsToOrg(orgId) && getUserRole() in ['superadmin', 'gerente', 'supervisor'];
    }

    function isInspectorInOrg(orgId) {
      return belongsToOrg(orgId) && getUserRole() in ['superadmin', 'gerente', 'supervisor', 'inspector'];
    }

    function isCampoInOrg(orgId) {
      return belongsToOrg(orgId) && getUserRole() in ['superadmin', 'gerente', 'supervisor', 'inspector', 'campo'];
    }

    // ===============================================================
    // User Profiles
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperadmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && !request.resource.data.keys().hasAny(['role']);
      allow update: if isSuperadmin();
      allow delete: if isSuperadmin();
    }

    // ===============================================================
    // Public Client Portals & Access Logs
    // ===============================================================
    match /client_portals/{portalId} {
      allow read: if isAuthenticated();
      allow create, update: if isGerenteInOrg(orgId);
      allow delete: if isSuperadmin();
    }

    match /client_portal_access_logs/{logId} {
      allow read: if isGerenteInOrg(orgId);
      allow create: if isAuthenticated();
    }

    // ===============================================================
    // Root Collections — Bloqueado
    // ===============================================================
    match /projects/{document} { allow read, write: if false; }
    match /tasks/{document} { allow read, write: if false; }
    match /valuations/{document} { allow read, write: if false; }
    match /expenses/{document} { allow read, write: if false; }
    match /field_reports/{document} { allow read, write: if false; }
    match /siho_ptw/{document} { allow read, write: if false; }
    match /ptws/{document} { allow read, write: if false; }
    match /weld_joints/{document} { allow read, write: if false; }
    match /welds/{document} { allow read, write: if false; }
    match /ndt_reports/{document} { allow read, write: if false; }
    match /inventory/{document} { allow read, write: if false; }
    match /documents/{document} { allow read, write: if false; }
    match /ili_runs/{document} { allow read, write: if false; }
    match /standby_claims/{document} { allow read, write: if false; }
    match /moc_requests/{document} { allow read, write: if false; }
    match /fleet_equipment/{document} { allow read, write: if false; }
    match /interop_imports/{document} { allow read, write: if false; }
    match /dossier_compilations/{document} { allow read, write: if false; }
    match /settings/{document} { allow read, write: if false; }
    match /engineering_calcs/{document} { allow read, write: if false; }

    // ===============================================================
    // Multi-Tenancy: /organizations/{orgId}
    // ===============================================================
    match /organizations/{orgId} {
      allow read: if belongsToOrg(orgId);
      allow create, update, delete: if isSuperadmin();

      match /client_portals/{portalId} {
        allow read: if isAuthenticated();
        allow create, update: if isGerenteInOrg(orgId);
        allow delete: if isSuperadmin();
      }

      match /engineering_calcs/{calcId} {
        allow read: if isCampoInOrg(orgId);
        allow create, update: if isCampoInOrg(orgId);
        allow delete: if isGerenteInOrg(orgId);
      }

      match /projects/{projId} {
        allow read: if isCampoInOrg(orgId);
        allow create, update: if isGerenteInOrg(orgId);
        allow delete: if isSuperadmin();

        match /{subcollection=**} {
          allow read: if isCampoInOrg(orgId);
          allow create, update: if isCampoInOrg(orgId);
          allow delete: if isGerenteInOrg(orgId);
        }
      }
    }

    // ===============================================================
    // Collection Group Queries — Protegidas por orgId
    // ===============================================================
    match /{path=**}/tasks/{taskId} {
      allow read: if isAuthenticated() && resource.data.orgId == getUserData().orgId;
      allow create, update: if isSupervisorInOrg(resource.data.orgId);
      allow delete: if isGerenteInOrg(resource.data.orgId);
    }

    match /{path=**}/expenses/{expenseId} {
      allow read: if isAuthenticated() && resource.data.orgId == getUserData().orgId;
      allow create, update: if isGerenteInOrg(resource.data.orgId);
      allow delete: if isSuperadmin();
    }

    match /{path=**}/valuations/{valuationId} {
      allow read: if isAuthenticated() && resource.data.orgId == getUserData().orgId;
      allow create, update: if isGerenteInOrg(resource.data.orgId);
      allow delete: if isSuperadmin();
    }

    match /{path=**}/siho_ptw/{ptwId} {
      allow read: if isAuthenticated() && resource.data.orgId == getUserData().orgId;
      allow create, update: if isCampoInOrg(resource.data.orgId);
      allow delete: if isGerenteInOrg(resource.data.orgId);
    }

    match /{path=**}/weld_joints/{jointId} {
      allow read: if isAuthenticated() && resource.data.orgId == getUserData().orgId;
      allow create, update: if isInspectorInOrg(resource.data.orgId);
      allow delete: if isGerenteInOrg(resource.data.orgId);
    }
  }
}
