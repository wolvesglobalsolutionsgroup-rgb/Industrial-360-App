rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : null; // Denegar si no existe documento de usuario
    }

    function isSuperadmin() {
      return isAuthenticated() && getUserRole() == 'superadmin';
    }

    function isGerente() {
      return isAuthenticated() && (getUserRole() == 'superadmin' || getUserRole() == 'gerente');
    }

    function isSupervisor() {
      return isAuthenticated() && (getUserRole() == 'superadmin' || getUserRole() == 'gerente' || getUserRole() == 'supervisor');
    }

    function isInspector() {
      return isAuthenticated() && (getUserRole() == 'superadmin' || getUserRole() == 'gerente' || getUserRole() == 'supervisor' || getUserRole() == 'inspector');
    }

    function isCampo() {
      return isAuthenticated() && (getUserRole() == 'superadmin' || getUserRole() == 'gerente' || getUserRole() == 'supervisor' || getUserRole() == 'inspector' || getUserRole() == 'campo');
    }

    function isCliente() {
      return isAuthenticated();
    }

    // ===============================================================
    // Multi-Tenancy Hierarchy: /organizations/{orgId}
    // ===============================================================
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if isSuperadmin();

      match /projects/{projId} {
        allow read: if isAuthenticated();
        allow create, update: if isGerente();
        allow delete: if isSuperadmin();

        // Subcolecciones de Proyecto
        match /tasks/{taskId} {
          allow read: if isAuthenticated();
          allow write: if isSupervisor();
        }

        match /field_reports/{reportId} {
          allow read: if isAuthenticated();
          allow write: if isCampo();
        }

        match /valuations/{valuationId} {
          allow read: if isAuthenticated();
          allow write: if isGerente();
        }

        match /documents/{documentId} {
          allow read: if isAuthenticated();
          allow write: if isSupervisor();
        }

        match /expenses/{expenseId} {
          allow read: if isAuthenticated();
          allow write: if isGerente();
        }

        match /inventory/{itemId} {
          allow read: if isAuthenticated();
          allow write: if isSupervisor();
        }

        match /siho_ptw/{ptwId} {
          allow read: if isAuthenticated();
          allow write: if isCampo();
        }

        match /weld_joints/{jointId} {
          allow read: if isAuthenticated();
          allow write: if isInspector();
        }

        match /ndt_reports/{reportId} {
          allow read: if isAuthenticated();
          allow write: if isInspector();
        }

        match /ili_runs/{runId} {
          allow read: if isAuthenticated();
          allow write: if isInspector();
        }

        match /standby_claims/{claimId} {
          allow read: if isAuthenticated();
          allow write: if isGerente();
        }

        match /moc_requests/{mocId} {
          allow read: if isAuthenticated();
          allow write: if isGerente();
        }

        match /fleet_equipment/{equipId} {
          allow read: if isAuthenticated();
          allow write: if isSupervisor();
        }

        match /dossier_compilations/{dossierId} {
          allow read: if isAuthenticated();
          allow write: if isGerente();
        }

      }

      // Subcolecciones directas de Organización
      match /client_portals/{portalId} {
        // Intencionalmente público — portales compartidos con clientes externos sin autenticación
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /engineering_calcs/{calcId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ===============================================================
    // Legacy Collections (Compatibilidad Directa)
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /field_reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isCampo();
    }

    match /valuations/{valuationId} {
      allow read: if isAuthenticated();
      allow write: if isGerente();
    }

    match /documents/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow write: if isGerente();
    }

    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /routes/{routeId} {
      allow read, write: if isAuthenticated();
    }

    match /siho_ptw/{ptwId} {
      allow read: if isAuthenticated();
      allow write: if isCampo();
    }

    match /weld_joints/{jointId} {
      allow read: if isAuthenticated();
      allow write: if isInspector();
    }

    match /ndt_reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isInspector();
    }

    match /ili_runs/{runId} {
      allow read: if isAuthenticated();
      allow write: if isInspector();
    }

    match /standby_claims/{claimId} {
      allow read: if isAuthenticated();
      allow write: if isGerente();
    }

    match /moc_requests/{mocId} {
      allow read: if isAuthenticated();
      allow write: if isGerente();
    }

    match /fleet_equipment/{equipId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /interop_imports/{importId} {
      allow read: if isAuthenticated() && request.auth.uid != null;
      allow write: if isSupervisor();
    }

    match /dossier_compilations/{dossierId} {
      allow read: if isAuthenticated();
      allow write: if isGerente();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isGerente();
    }

    match /client_portals/{portalId} {
      // Intencionalmente público — portales compartidos con clientes externos sin autenticación
      allow read: if true;
      allow write: if isGerente();
    }

    match /engineering_calcs/{calcId} {
      allow read, write: if isAuthenticated();
    }
  }
}
