rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // IDENTIDAD Y AUTORIZACIÓN
    // ===============================================================

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function userRole() {
      return hasUserProfile() ? userData().role : null;
    }

    function isPlatformSuperadmin() {
      return hasUserProfile() && userRole() == 'superadmin';
    }

    function belongsToOrg(orgId) {
      return hasUserProfile() && userData().orgId == orgId;
    }

    function hasRoleInOrg(orgId, roles) {
      return isPlatformSuperadmin() || (belongsToOrg(orgId) && userRole() in roles);
    }

    function canManageOrg(orgId) {
      return hasRoleInOrg(orgId, ['gerente']);
    }

    function canSuperviseOrg(orgId) {
      return hasRoleInOrg(orgId, ['gerente', 'supervisor']);
    }

    function canInspectOrg(orgId) {
      return hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector']);
    }

    function canWorkInOrg(orgId) {
      return hasRoleInOrg(orgId, ['gerente', 'supervisor', 'inspector', 'campo']);
    }

    // ===============================================================
    // INTEGRIDAD DE DATOS MULTI-TENANT
    // ===============================================================

    function belongsToRouteOrg(orgId) {
      return request.resource.data.orgId == orgId;
    }

    function preservesRouteOrg(orgId) {
      return request.resource.data.orgId == orgId
        && resource.data.orgId == orgId
        && request.resource.data.orgId == resource.data.orgId;
    }

    function belongsToRouteProject(orgId, projectId) {
      return belongsToRouteOrg(orgId)
        && request.resource.data.projectId == projectId;
    }

    function preservesRouteProject(orgId, projectId) {
      return preservesRouteOrg(orgId)
        && request.resource.data.projectId == projectId
        && resource.data.projectId == projectId;
    }

    function isCreator() {
      return request.resource.data.createdBy == request.auth.uid;
    }

    function hasServerCreationTimestamp() {
      return request.resource.data.createdAt == request.time;
    }

    function hasServerUpdateTimestamp() {
      return request.resource.data.updatedAt == request.time;
    }

    function preservesImmutableFields(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // PERFIL DE USUARIO
    // ===============================================================
    //
    // Importante: la creación inicial NO puede asignar role ni orgId.
    // Una Cloud Function/Admin SDK debe asignarlos luego de invitación,
    // onboarding o aprobación administrativa.
    //
    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId
        || (hasUserProfile() && resource.data.orgId == userData().orgId)
        || isPlatformSuperadmin()
      );
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['email', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ===============================================================
    // ORGANIZACIONES
    // ===============================================================

    match /organizations/{orgId} {
      allow get: if belongsToOrg(orgId) || isPlatformSuperadmin();
      allow list: if false;
      allow create, update, delete: if false;

      // -------------------------------------------------------------
      // PROYECTOS
      // -------------------------------------------------------------
      match /projects/{projectId} {
        allow read: if canWorkInOrg(orgId);
        allow create: if canManageOrg(orgId)
          && belongsToRouteOrg(orgId)
          && isCreator()
          && hasServerCreationTimestamp()
          && hasServerUpdateTimestamp();
        allow update: if canManageOrg(orgId)
          && preservesRouteOrg(orgId)
          && preservesImmutableFields(['orgId', 'createdBy', 'createdAt'])
          && hasServerUpdateTimestamp();
        allow delete: if canManageOrg(orgId);

        // -----------------------------------------------------------
        // TAREAS
        // -----------------------------------------------------------
        match /tasks/{taskId} {
          allow read: if canWorkInOrg(orgId);
          allow create: if canSuperviseOrg(orgId)
            && belongsToRouteProject(orgId, projectId)
            && isCreator()
            && hasServerCreationTimestamp()
            && hasServerUpdateTimestamp();
          allow update: if canSuperviseOrg(orgId)
            && preservesRouteProject(orgId, projectId)
            && preservesImmutableFields(['orgId', 'projectId', 'createdBy', 'createdAt'])
            && hasServerUpdateTimestamp();
          allow delete: if canManageOrg(orgId);
        }

        // -----------------------------------------------------------
        // GASTOS
        // -----------------------------------------------------------
        match /expenses/{expenseId} {
          allow read: if canWorkInOrg(orgId);
          allow create: if canManageOrg(orgId)
            && belongsToRouteProject(orgId, projectId)
            && isCreator()
            && hasServerCreationTimestamp()
            && hasServerUpdateTimestamp();
          allow update: if canManageOrg(orgId)
            && preservesRouteProject(orgId, projectId)
            && preservesImmutableFields(['orgId', 'projectId', 'createdBy', 'createdAt'])
            && hasServerUpdateTimestamp();
          allow delete: if canManageOrg(orgId);
        }

        // -----------------------------------------------------------
        // VALUACIONES
        // -----------------------------------------------------------
        match /valuations/{valuationId} {
          allow read: if canWorkInOrg(orgId);
          allow create: if canManageOrg(orgId)
            && belongsToRouteProject(orgId, projectId)
            && isCreator()
            && hasServerCreationTimestamp()
            && hasServerUpdateTimestamp();
          allow update: if canManageOrg(orgId)
            && preservesRouteProject(orgId, projectId)
            && preservesImmutableFields([
              'orgId', 'projectId', 'createdBy', 'createdAt',
              'approvedBy', 'approvedAt', 'status'
            ])
            && hasServerUpdateTimestamp();
          allow delete: if false;
        }

        // -----------------------------------------------------------
        // SIHO / PTW
        // -----------------------------------------------------------
        match /siho_ptw/{ptwId} {
          allow read: if canWorkInOrg(orgId);
          allow create: if canWorkInOrg(orgId)
            && belongsToRouteProject(orgId, projectId)
            && isCreator()
            && hasServerCreationTimestamp()
            && hasServerUpdateTimestamp();
          allow update: if canWorkInOrg(orgId)
            && preservesRouteProject(orgId, projectId)
            && preservesImmutableFields([
              'orgId', 'projectId', 'createdBy', 'createdAt',
              'approvedBy', 'approvedAt'
            ])
            && hasServerUpdateTimestamp();
          allow delete: if canManageOrg(orgId);
        }

        // -----------------------------------------------------------
        // QA/QC SOLDADURA
        // -----------------------------------------------------------
        match /weld_joints/{jointId} {
          allow read: if canWorkInOrg(orgId);
          allow create: if canInspectOrg(orgId)
            && belongsToRouteProject(orgId, projectId)
            && isCreator()
            && hasServerCreationTimestamp()
            && hasServerUpdateTimestamp();
          allow update: if canInspectOrg(orgId)
            && preservesRouteProject(orgId, projectId)
            && preservesImmutableFields([
              'orgId', 'projectId', 'createdBy', 'createdAt',
              'approvedBy', 'approvedAt'
            ])
            && hasServerUpdateTimestamp();
          allow delete: if canManageOrg(orgId);
        }

        // -----------------------------------------------------------
        // REPORTES DE CAMPO
        // -----------------------------------------------------------
        match /field_reports/{reportId} {
          allow read: if canWorkInOrg(orgId);
          allow create: if canWorkInOrg(orgId)
            && belongsToRouteProject(orgId, projectId)
            && isCreator()
            && hasServerCreationTimestamp()
            && hasServerUpdateTimestamp();
          allow update: if canWorkInOrg(orgId)
            && preservesRouteProject(orgId, projectId)
            && preservesImmutableFields([
              'orgId', 'projectId', 'createdBy', 'createdAt',
              'approvedBy', 'approvedAt'
            ])
            && hasServerUpdateTimestamp();
          allow delete: if canManageOrg(orgId);
        }

        // -----------------------------------------------------------
        // INVENTARIO
        // -----------------------------------------------------------
        match /inventory/{itemId} {
          allow read: if canWorkInOrg(orgId);
          allow create: if canSuperviseOrg(orgId)
            && belongsToRouteProject(orgId, projectId)
            && isCreator()
            && hasServerCreationTimestamp()
            && hasServerUpdateTimestamp();
          allow update: if canSuperviseOrg(orgId)
            && preservesRouteProject(orgId, projectId)
            && preservesImmutableFields(['orgId', 'projectId', 'createdBy', 'createdAt'])
            && hasServerUpdateTimestamp();
          allow delete: if canManageOrg(orgId);
        }

        // -----------------------------------------------------------
        // DOCUMENTOS
        // -----------------------------------------------------------
        match /documents/{documentId} {
          allow read: if canWorkInOrg(orgId);
          allow create: if canSuperviseOrg(orgId)
            && belongsToRouteProject(orgId, projectId)
            && isCreator()
            && hasServerCreationTimestamp()
            && hasServerUpdateTimestamp();
          allow update: if canSuperviseOrg(orgId)
            && preservesRouteProject(orgId, projectId)
            && preservesImmutableFields(['orgId', 'projectId', 'createdBy', 'createdAt'])
            && hasServerUpdateTimestamp();
          allow delete: if canManageOrg(orgId);
        }

        // -----------------------------------------------------------
        // INTEGRIDAD / ILI
        // -----------------------------------------------------------
        match /ili_runs/{runId} {
          allow read: if canWorkInOrg(orgId);
          allow create: if canInspectOrg(orgId)
            && belongsToRouteProject(orgId, projectId)
            && isCreator()
            && hasServerCreationTimestamp()
            && hasServerUpdateTimestamp();
          allow update: if canInspectOrg(orgId)
            && preservesRouteProject(orgId, projectId)
            && preservesImmutableFields([
              'orgId', 'projectId', 'createdBy', 'createdAt',
              'approvedBy', 'approvedAt'
            ])
            && hasServerUpdateTimestamp();
          allow delete: if canManageOrg(orgId);
        }

        // -----------------------------------------------------------
        // DOSSIER
        // -----------------------------------------------------------
        match /dossier_compilations/{compilationId} {
          allow read: if canWorkInOrg(orgId);
          allow create: if canSuperviseOrg(orgId)
            && belongsToRouteProject(orgId, projectId)
            && isCreator()
            && hasServerCreationTimestamp()
            && hasServerUpdateTimestamp();
          allow update: if canSuperviseOrg(orgId)
            && preservesRouteProject(orgId, projectId)
            && preservesImmutableFields([
              'orgId', 'projectId', 'createdBy', 'createdAt',
              'signedBy', 'signedAt'
            ])
            && hasServerUpdateTimestamp();
          allow delete: if canManageOrg(orgId);
        }
      }

      // -------------------------------------------------------------
      // PORTAL CLIENTE: ANIDADO EN ORGANIZACIÓN
      // -------------------------------------------------------------
      match /client_portals/{portalId} {
        allow read: if belongsToOrg(orgId) || isPlatformSuperadmin();
        allow create: if canManageOrg(orgId)
          && belongsToRouteOrg(orgId)
          && isCreator()
          && hasServerCreationTimestamp()
          && hasServerUpdateTimestamp();
        allow update: if canManageOrg(orgId)
          && preservesRouteOrg(orgId)
          && preservesImmutableFields(['orgId', 'createdBy', 'createdAt'])
          && hasServerUpdateTimestamp();
        allow delete: if canManageOrg(orgId);
      }

      // -------------------------------------------------------------
      // AUDIT LOGS: SOLO BACKEND
      // -------------------------------------------------------------
      match /audit_logs/{logId} {
        allow read: if canManageOrg(orgId);
        allow create, update, delete: if false;
      }
    }

    // ===============================================================
    // PORTALES Y LOGS ROOT LEGACY: CERRADOS
    // ===============================================================
    match /client_portals/{portalId} { allow read, write: if false; }
    match /client_portal_access_logs/{logId} { allow read, write: if false; }

    // ===============================================================
    // COLECCIONES LEGACY RAÍZ: BLOQUEO TOTAL
    // ===============================================================
    match /projects/{document} { allow read, write: if false; }
    match /tasks/{document} { allow read, write: if false; }
    match /valuations/{document} { allow read, write: if false; }
    match /expenses/{document} { allow read, write: if false; }
    match /field_reports/{document} { allow read, write: if false; }
    match /siho_ptw/{document} { allow read, write: if false; }
    match /ptws/{document} { allow read, write: if false; }
    match /weld_joints/{document} { allow read, write: if false; }
    match /welds/{document} { allow read, write: if false; }
    match /ndt_reports/{document} { allow read, write: if false; }
    match /inventory/{document} { allow read, write: if false; }
    match /documents/{document} { allow read, write: if false; }
    match /ili_runs/{document} { allow read, write: if false; }
    match /standby_claims/{document} { allow read, write: if false; }
    match /moc_requests/{document} { allow read, write: if false; }
    match /fleet_equipment/{document} { allow read, write: if false; }
    match /interop_imports/{document} { allow read, write: if false; }
    match /dossier_compilations/{document} { allow read, write: if false; }
    match /settings/{document} { allow read, write: if false; }
    match /engineering_calcs/{document} { allow read, write: if false; }

    // ===============================================================
    // DEFAULT DENY — CATCH-ALL FINAL
    // ===============================================================
    match /{document=**} { allow read, write: if false; }
  }
}
