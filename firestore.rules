rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions & Role Enforcement
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : null;
    }

    function isSuperadmin() {
      return isAuthenticated() && getUserRole() == 'superadmin';
    }

    function isGerente() {
      return isAuthenticated() && getUserRole() in ['superadmin', 'gerente'];
    }

    function isSupervisor() {
      return isAuthenticated() && getUserRole() in ['superadmin', 'gerente', 'supervisor'];
    }

    function isInspector() {
      return isAuthenticated() && getUserRole() in ['superadmin', 'gerente', 'supervisor', 'inspector'];
    }

    function isCampo() {
      return isAuthenticated() && getUserRole() in ['superadmin', 'gerente', 'supervisor', 'inspector', 'campo'];
    }

    // ===============================================================
    // User Profiles
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isSuperadmin());
      allow delete: if isSuperadmin();
    }

    // ===============================================================
    // Public Client Portals & Access Logs (Secure External Access)
    // ===============================================================
    match /client_portals/{portalId} {
      allow read: if isAuthenticated();
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /client_portal_access_logs/{logId} {
      allow read: if isGerente();
      allow create: if isAuthenticated();
    }

    // ===============================================================
    // Root Operational Collections — Bloqueado (Migrado a /organizations/{orgId})
    // ===============================================================
    match /projects/{document} { allow read, write: if false; }
    match /tasks/{document} { allow read, write: if false; }
    match /valuations/{document} { allow read, write: if false; }
    match /expenses/{document} { allow read, write: if false; }
    match /field_reports/{document} { allow read, write: if false; }
    match /siho_ptw/{document} { allow read, write: if false; }
    match /ptws/{document} { allow read, write: if false; }
    match /weld_joints/{document} { allow read, write: if false; }
    match /welds/{document} { allow read, write: if false; }
    match /ndt_reports/{document} { allow read, write: if false; }
    match /inventory/{document} { allow read, write: if false; }
    match /documents/{document} { allow read, write: if false; }
    match /ili_runs/{document} { allow read, write: if false; }
    match /standby_claims/{document} { allow read, write: if false; }
    match /moc_requests/{document} { allow read, write: if false; }
    match /fleet_equipment/{document} { allow read, write: if false; }
    match /interop_imports/{document} { allow read, write: if false; }
    match /dossier_compilations/{document} { allow read, write: if false; }
    match /settings/{document} { allow read, write: if false; }
    match /engineering_calcs/{document} { allow read, write: if false; }

    // ===============================================================
    // Multi-Tenancy Hierarchy: /organizations/{orgId}
    // ===============================================================
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperadmin();

      match /client_portals/{portalId} {
        allow read: if isAuthenticated();
        allow create, update: if isGerente();
        allow delete: if isSuperadmin();
      }

      match /engineering_calcs/{calcId} {
        allow read: if isAuthenticated();
        allow create, update: if isCampo();
        allow delete: if isGerente();
      }

      match /projects/{projId} {
        allow read: if isAuthenticated();
        allow create, update: if isGerente();
        allow delete: if isSuperadmin();

        match /{subcollection=**} {
          allow read: if isAuthenticated();
          allow create, update: if isCampo();
          allow delete: if isGerente();
        }
      }
    }

    // ===============================================================
    // Collection Group Queries Support
    // ===============================================================
    match /{path=**}/tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create, update: if isSupervisor();
      allow delete: if isGerente();
    }

    match /{path=**}/expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /{path=**}/valuations/{valuationId} {
      allow read: if isAuthenticated();
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /{path=**}/siho_ptw/{ptwId} {
      allow read: if isAuthenticated();
      allow create, update: if isCampo();
      allow delete: if isGerente();
    }

    match /{path=**}/weld_joints/{jointId} {
      allow read: if isAuthenticated();
      allow create, update: if isInspector();
      allow delete: if isGerente();
    }
  }
}
