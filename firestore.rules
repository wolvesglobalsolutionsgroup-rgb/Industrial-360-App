rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function signedIn() {
      return true; // Allow access for authenticated, anonymous, and demo app users
    }

    // 1. User Profiles (/users/{userId})
    match /users/{userId} {
      allow read, write: if signedIn();
    }

    // 2. Multi-Tenancy Hierarchy (/organizations/{orgId})
    match /organizations/{orgId} {
      allow read, write: if signedIn();

      match /{subcollection=**} {
        allow read, write: if signedIn();
      }
    }

    // 3. Direct Root Collections (Projects & operational items)
    match /projects/{projId} {
      allow read, write: if signedIn();
      match /{subcollection=**} {
        allow read, write: if signedIn();
      }
    }

    match /settings/{id} { allow read, write: if signedIn(); }
    match /tasks/{id} { allow read, write: if signedIn(); }
    match /expenses/{id} { allow read, write: if signedIn(); }
    match /valuations/{id} { allow read, write: if signedIn(); }
    match /siho_ptw/{id} { allow read, write: if signedIn(); }
    match /weld_joints/{id} { allow read, write: if signedIn(); }
    match /field_reports/{id} { allow read, write: if signedIn(); }
    match /documents/{id} { allow read, write: if signedIn(); }
    match /inventory/{id} { allow read, write: if signedIn(); }
    match /routes/{id} { allow read, write: if signedIn(); }
    match /engineering_calcs/{id} { allow read, write: if signedIn(); }
    match /client_portals/{id} { allow read, write: if signedIn(); }
    match /hot_tap_interventions/{id} { allow read, write: if signedIn(); }
    match /procurement/{id} { allow read, write: if signedIn(); }
    match /apus/{id} { allow read, write: if signedIn(); }
    match /quantity_takeoffs/{id} { allow read, write: if signedIn(); }
    match /workers/{id} { allow read, write: if signedIn(); }
    match /worker_attendance/{id} { allow read, write: if signedIn(); }

    // 4. Collection Group Queries
    match /{path=**}/settings/{id} { allow read, write: if signedIn(); }
    match /{path=**}/tasks/{id} { allow read, write: if signedIn(); }
    match /{path=**}/expenses/{id} { allow read, write: if signedIn(); }
    match /{path=**}/valuations/{id} { allow read, write: if signedIn(); }
    match /{path=**}/siho_ptw/{id} { allow read, write: if signedIn(); }
    match /{path=**}/weld_joints/{id} { allow read, write: if signedIn(); }
    match /{path=**}/field_reports/{id} { allow read, write: if signedIn(); }
    match /{path=**}/documents/{id} { allow read, write: if signedIn(); }
    match /{path=**}/inventory/{id} { allow read, write: if signedIn(); }
    match /{path=**}/routes/{id} { allow read, write: if signedIn(); }
    match /{path=**}/hot_tap_interventions/{id} { allow read, write: if signedIn(); }
    match /{path=**}/procurement/{id} { allow read, write: if signedIn(); }
    match /{path=**}/apus/{id} { allow read, write: if signedIn(); }
    match /{path=**}/quantity_takeoffs/{id} { allow read, write: if signedIn(); }
    match /{path=**}/client_portals/{id} { allow read, write: if signedIn(); }
    match /{path=**}/client_portal_access_logs/{id} { allow read, write: if signedIn(); }
    match /{path=**}/workers/{id} { allow read, write: if signedIn(); }
    match /{path=**}/worker_attendance/{id} { allow read, write: if signedIn(); }

    // 5. Default Catch-All
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}

