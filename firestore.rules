rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : 'campo';
    }

    function isSuperadmin() {
      return isAuthenticated() && getUserRole() == 'superadmin';
    }

    function isGerente() {
      return isAuthenticated();
    }

    function isSupervisor() {
      return isAuthenticated();
    }

    function isInspector() {
      return isAuthenticated();
    }

    function isCampo() {
      return isAuthenticated();
    }

    // ===============================================================
    // User Profiles
    // ===============================================================
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // ===============================================================
    // Root Collections (Legacy & App Operations)
    // ===============================================================
    match /projects/{projectId} {
      allow read, write: if isAuthenticated();
    }

    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /field_reports/{reportId} {
      allow read, write: if isAuthenticated();
    }

    match /valuations/{valuationId} {
      allow read, write: if isAuthenticated();
    }

    match /documents/{documentId} {
      allow read, write: if isAuthenticated();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAuthenticated();
    }

    match /inventory/{itemId} {
      allow read, write: if isAuthenticated();
    }

    match /routes/{routeId} {
      allow read, write: if isAuthenticated();
    }

    match /siho_ptw/{ptwId} {
      allow read, write: if isAuthenticated();
    }

    match /ptws/{ptwId} {
      allow read, write: if isAuthenticated();
    }

    match /weld_joints/{jointId} {
      allow read, write: if isAuthenticated();
    }

    match /welds/{weldId} {
      allow read, write: if isAuthenticated();
    }

    match /ndt_reports/{reportId} {
      allow read, write: if isAuthenticated();
    }

    match /ili_runs/{runId} {
      allow read, write: if isAuthenticated();
    }

    match /standby_claims/{claimId} {
      allow read, write: if isAuthenticated();
    }

    match /moc_requests/{mocId} {
      allow read, write: if isAuthenticated();
    }

    match /fleet_equipment/{equipId} {
      allow read, write: if isAuthenticated();
    }

    match /interop_imports/{importId} {
      allow read, write: if isAuthenticated();
    }

    match /dossier_compilations/{dossierId} {
      allow read, write: if isAuthenticated();
    }

    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    match /client_portals/{portalId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /engineering_calcs/{calcId} {
      allow read, write: if isAuthenticated();
    }

    // ===============================================================
    // Multi-Tenancy Hierarchy: /organizations/{orgId}
    // ===============================================================
    match /organizations/{orgId} {
      allow read, write: if isAuthenticated();

      match /client_portals/{portalId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /engineering_calcs/{calcId} {
        allow read, write: if isAuthenticated();
      }

      match /projects/{projId} {
        allow read, write: if isAuthenticated();

        match /{subcollection=**} {
          allow read, write: if isAuthenticated();
        }
      }
    }
  }
}
