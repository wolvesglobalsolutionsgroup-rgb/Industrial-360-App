rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions & Role Enforcement
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : 'campo';
    }

    function isSuperadmin() {
      return isAuthenticated() && (getUserRole() == 'superadmin' || !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    function isGerente() {
      return isAuthenticated() && (getUserRole() in ['superadmin', 'gerente'] || !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    function isSupervisor() {
      return isAuthenticated() && (getUserRole() in ['superadmin', 'gerente', 'supervisor'] || !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    function isInspector() {
      return isAuthenticated() && (getUserRole() in ['superadmin', 'gerente', 'supervisor', 'inspector'] || !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    function isCampo() {
      return isAuthenticated() && (getUserRole() in ['superadmin', 'gerente', 'supervisor', 'inspector', 'campo'] || !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    // ===============================================================
    // User Profiles
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isSuperadmin());
      allow delete: if isSuperadmin();
    }

    // ===============================================================
    // Public Client Portals & Access Logs (Secure External Access)
    // ===============================================================
    match /client_portals/{portalId} {
      allow read: if true;
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /client_portal_access_logs/{logId} {
      allow read: if isGerente();
      allow create: if true;
    }

    // ===============================================================
    // Root Operational Collections (Public Read for Client Portals & App Users)
    // ===============================================================
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow create, update: if isSupervisor();
      allow delete: if isGerente();
    }

    match /valuations/{valuationId} {
      allow read: if true;
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /field_reports/{reportId} {
      allow read: if true;
      allow create, update: if isCampo();
      allow delete: if isSupervisor();
    }

    match /siho_ptw/{ptwId} {
      allow read: if true;
      allow create, update: if isCampo();
      allow delete: if isGerente();
    }

    match /ptws/{ptwId} {
      allow read: if true;
      allow create, update: if isCampo();
      allow delete: if isGerente();
    }

    match /weld_joints/{jointId} {
      allow read: if true;
      allow create, update: if isInspector();
      allow delete: if isGerente();
    }

    match /welds/{weldId} {
      allow read: if true;
      allow create, update: if isInspector();
      allow delete: if isGerente();
    }

    match /ndt_reports/{reportId} {
      allow read: if true;
      allow create, update: if isInspector();
      allow delete: if isGerente();
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow create, update: if isSupervisor();
      allow delete: if isGerente();
    }

    match /documents/{documentId} {
      allow read: if true;
      allow create, update: if isCampo();
      allow delete: if isGerente();
    }

    match /ili_runs/{runId} {
      allow read: if true;
      allow create, update: if isInspector();
      allow delete: if isGerente();
    }

    match /standby_claims/{claimId} {
      allow read: if true;
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /moc_requests/{mocId} {
      allow read: if true;
      allow create, update: if isSupervisor();
      allow delete: if isGerente();
    }

    match /fleet_equipment/{equipId} {
      allow read: if true;
      allow create, update: if isSupervisor();
      allow delete: if isGerente();
    }

    match /interop_imports/{importId} {
      allow read: if true;
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /dossier_compilations/{dossierId} {
      allow read: if true;
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /engineering_calcs/{calcId} {
      allow read: if true;
      allow create, update: if isCampo();
      allow delete: if isGerente();
    }

    // ===============================================================
    // Multi-Tenancy Hierarchy: /organizations/{orgId}
    // ===============================================================
    match /organizations/{orgId} {
      allow read: if true;
      allow create, update, delete: if isSuperadmin();

      match /client_portals/{portalId} {
        allow read: if true;
        allow create, update: if isGerente();
        allow delete: if isSuperadmin();
      }

      match /engineering_calcs/{calcId} {
        allow read: if true;
        allow create, update: if isCampo();
        allow delete: if isGerente();
      }

      match /projects/{projId} {
        allow read: if true;
        allow create, update: if isGerente();
        allow delete: if isSuperadmin();

        match /{subcollection=**} {
          allow read: if true;
          allow create, update: if isCampo();
          allow delete: if isGerente();
        }
      }
    }

    // ===============================================================
    // Collection Group Queries Support
    // ===============================================================
    match /{path=**}/tasks/{taskId} {
      allow read: if true;
      allow create, update: if isSupervisor();
      allow delete: if isGerente();
    }

    match /{path=**}/expenses/{expenseId} {
      allow read: if true;
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /{path=**}/valuations/{valuationId} {
      allow read: if true;
      allow create, update: if isGerente();
      allow delete: if isSuperadmin();
    }

    match /{path=**}/siho_ptw/{ptwId} {
      allow read: if true;
      allow create, update: if isCampo();
      allow delete: if isGerente();
    }

    match /{path=**}/weld_joints/{jointId} {
      allow read: if true;
      allow create, update: if isInspector();
      allow delete: if isGerente();
    }
  }
}
