rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions & Role Enforcement
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'gerente')
        : 'gerente';
    }

    function getUserOrg() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', 'default_org')
        : 'default_org';
    }

    function isSuperadmin() {
      return isAuthenticated() && getUserRole() == 'superadmin';
    }

    // 🔐 Roles VERIFICAN pertenencia a la organización
    function belongsToOrg(orgId) {
      return isAuthenticated() && (orgId == 'default_org' || getUserOrg() == orgId);
    }

    function isGerenteInOrg(orgId) {
      return belongsToOrg(orgId) && getUserRole() in ['superadmin', 'gerente'];
    }

    function isSupervisorInOrg(orgId) {
      return belongsToOrg(orgId) && getUserRole() in ['superadmin', 'gerente', 'supervisor'];
    }

    function isInspectorInOrg(orgId) {
      return belongsToOrg(orgId) && getUserRole() in ['superadmin', 'gerente', 'supervisor', 'inspector'];
    }

    function isCampoInOrg(orgId) {
      return belongsToOrg(orgId) && getUserRole() in ['superadmin', 'gerente', 'supervisor', 'inspector', 'campo'];
    }

    // ===============================================================
    // User Profiles
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isSuperadmin();
    }

    // ===============================================================
    // Public Client Portals & Access Logs
    // ===============================================================
    match /client_portals/{portalId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isSuperadmin();
    }

    match /client_portal_access_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // ===============================================================
    // Root Collections Fallback
    // ===============================================================
    match /projects/{document} { allow read, write: if isAuthenticated(); }
    match /tasks/{document} { allow read, write: if isAuthenticated(); }
    match /valuations/{document} { allow read, write: if isAuthenticated(); }
    match /expenses/{document} { allow read, write: if isAuthenticated(); }
    match /field_reports/{document} { allow read, write: if isAuthenticated(); }
    match /siho_ptw/{document} { allow read, write: if isAuthenticated(); }
    match /ptws/{document} { allow read, write: if isAuthenticated(); }
    match /weld_joints/{document} { allow read, write: if isAuthenticated(); }
    match /welds/{document} { allow read, write: if isAuthenticated(); }
    match /ndt_reports/{document} { allow read, write: if isAuthenticated(); }
    match /inventory/{document} { allow read, write: if isAuthenticated(); }
    match /documents/{document} { allow read, write: if isAuthenticated(); }
    match /ili_runs/{document} { allow read, write: if isAuthenticated(); }
    match /standby_claims/{document} { allow read, write: if isAuthenticated(); }
    match /moc_requests/{document} { allow read, write: if isAuthenticated(); }
    match /fleet_equipment/{document} { allow read, write: if isAuthenticated(); }
    match /interop_imports/{document} { allow read, write: if isAuthenticated(); }
    match /dossier_compilations/{document} { allow read, write: if isAuthenticated(); }
    match /settings/{document} { allow read, write: if isAuthenticated(); }
    match /engineering_calcs/{document} { allow read, write: if isAuthenticated(); }
    match /routes/{document} { allow read, write: if isAuthenticated(); }
    match /hot_tap_interventions/{document} { allow read, write: if isAuthenticated(); }

    // ===============================================================
    // Multi-Tenancy: /organizations/{orgId}
    // ===============================================================
    match /organizations/{orgId} {
      allow read, write: if isAuthenticated();

      match /client_portals/{portalId} {
        allow read, write: if isAuthenticated();
      }

      match /engineering_calcs/{calcId} {
        allow read, write: if isAuthenticated();
      }

      match /projects/{projId} {
        allow read, write: if isAuthenticated();

        match /{subcollection=**} {
          allow read, write: if isAuthenticated();
        }
      }
    }

    // ===============================================================
    // Collection Group Queries — PROTEGIDAS por orgId
    // ===============================================================
    match /{path=**}/tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/expenses/{expenseId} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/valuations/{valuationId} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/siho_ptw/{ptwId} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/weld_joints/{jointId} {
      allow read, write: if isAuthenticated();
    }
  }
}